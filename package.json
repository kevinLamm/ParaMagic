{
  "name": "paramagic",
  "version": "0.1.0",
  "description": "Professional 2D vector parametric drawing application prototype",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:legacy": "node scripts/dev-server.js",
    "build": "node scripts/validate-app.js && vite build",
    "build:pages": "node scripts/validate-app.js && vite build --mode github-pages",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode github-pages",
    "test": "node --test src/tests/*.test.js",
    "test:export": "node --test src/tests/drawingFileSystem.test.js src/tests/imageFillSystem.test.js src/tests/pngExport.test.js src/tests/portableImageAssets.test.js src/tests/svgExport.test.js",
    "test:dxf": "node --test src/tests/drawingIO.test.js src/tests/dxfExport.test.js",
    "test:dxf:autodesk": "node scripts/test-autodesk-dxf.mjs",
    "fixture:dxf:autodesk": "node scripts/generate-autodesk-dxf-fixture.mjs",
    "benchmark:solver": "node scripts/benchmark-solver.js",
    "benchmark:solver:browser": "node scripts/solver-baseline/run-browser.mjs",
    "build:solver": "node scripts/build-solver-wasm.mjs",
    "predev": "npm run build:solver",
    "prebuild": "npm run build:solver",
    "prebuild:pages": "npm run build:solver"
  },
  "dependencies": {
    "@paramagic/core": "file:packages/paramagic-core",
    "firebase": "^12.19.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "esbuild": "^0.27.3",
    "miniflare": "^4.20260515.0",
    "vite": "^8.2.2",
    "wrangler": "^4.92.0"
  }
}
